{
  "name": "quiz-builder",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.0.0",
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend --prefix-colors blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=@quiz-builder/frontend",
    "dev:backend": "npm run dev --workspace=@quiz-builder/backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate --workspace=@quiz-builder/backend",
    "db:migrate": "npm run prisma:migrate --workspace=@quiz-builder/backend",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace=@quiz-builder/backend",
    "db:seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.10"
  }
}
